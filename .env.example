# Kopieer naar .env.local (lokaal) of zet deze variabelen in Vercel (Project Settings > Environment Variables).

# --- Online betalen (Mollie) ---
# Test: test_xxxxxxxx  |  Live: live_xxxxxxxx  (Mollie dashboard > Developers > API keys)
MOLLIE_API_KEY=

# Vaste basis-URL van de site (voor Mollie redirect/webhook en de link-preview). Leeg = automatisch.
SITE_URL=https://foodplug-one.vercel.app

# --- WhatsApp: melding aan de zaak + verificatiecode naar de klant ---
# console = alleen loggen in de terminal (lokaal testen; op productie telt dit NIET als actief)
# twilio  = Twilio WhatsApp-sandbox (om te testen; alleen nummers die de sandbox joinden ontvangen iets)
# meta    = WhatsApp Cloud API van Meta (voor live)
WHATSAPP_PROVIDER=console

# Nummer van de eigenaar dat elke bestelling ontvangt, met landcode
OWNER_WHATSAPP=+32485117492

# Twilio (sandbox)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886
# Op een Twilio-PROEFaccount mag je geen eigen tekst sturen, alleen een sjabloon van Twilio (ContentSid, begint met HX).
# VARS = welke waarde op welke plek komt. Beschikbaar voor bestellingen: {ref} {slot} {customer} {name} {items}
# {total} {pay} {note}; voor codes: {code}. Laat de SID leeg om gewone tekst te sturen (betaald account).
TWILIO_ORDER_CONTENT_SID=
TWILIO_ORDER_VARS='{"1":"{ref}","2":"{slot}"}'
TWILIO_CODE_CONTENT_SID=
TWILIO_CODE_VARS='{"1":"Foodplug","2":"{code}"}'

# Meta WhatsApp Cloud API
META_WA_TOKEN=
META_WA_PHONE_ID=
# template = goedgekeurde sjablonen (altijd, nodig voor live)
# text     = gewone tekst: werkt alleen als dit nummer de laatste 24 uur zelf een bericht naar het
#            testnummer stuurde. Handig om te testen zonder goedgekeurd sjabloon.
META_WA_MODE=template
META_WA_TEMPLATE=nieuwe_bestelling
META_WA_OTP_TEMPLATE=bevestigingscode
META_WA_LANG=nl
# Sjabloon "nieuwe_bestelling" (Utility, Nederlands), 7 parameters:
# Nieuwe bestelling {{1}}. Afhalen: {{2}}. Klant: {{3}}. Bestelling: {{4}}. Totaal: {{5}}. Betaling: {{6}}. Opmerking: {{7}}
# Sjabloon "bevestigingscode" (categorie Authentication, Nederlands, knop "Code kopiëren").

# --- Telefoonverificatie voor cash-bestellingen ---
# Willekeurige lange tekst (bv. `openssl rand -hex 32`). Verplicht op productie, anders staat cash uit.
VERIFY_SECRET=
# Hoe lang een bevestigd nummer geldig blijft (minuten, standaard 120)
VERIFY_TOKEN_TTL_MIN=120
# off = geen verificatie (alleen om te testen)
PHONE_VERIFICATION=on
